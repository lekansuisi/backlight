/*
 * C1 Mirror97 RGB · 97 键 · 左手真镜像数字区 · Choc V2
 * 主控：nice!nano v2（NRF52840，ZMK board = nice_nano_v2）
 *
 * 矩阵：10 行 x 10 列，二极管阴极接 COL -> diode-direction = "row2col"
 *       row2col 下 rows 为输出、cols 为输入
 *       脚位：18 个边缘 GPIO 做 ROW0..9 + COL0..7；
 *             COL8/COL9 用主控背面 P1.01 / P1.02（方案 A，已 DRC 验证）
 *
 * RGB 灯链：98 颗 SK6812 MINI-E（97 键下灯 + 1 状态灯），串成一条链。
 *       数据脚 = P1.07 (gpio1 7) -> 板载 74AHCT1G125 电平转换 -> 灯链 DIN
 *       用 SPI3 的 MOSI 驱动（WS2812/SK6812 单总线，4MHz），
 *       P1.07 作为 SPIM MOSI 映射到 pinctrl。
 *       灯序已按 v20 重排（按列蛇形），末灯紧邻右上角状态灯。
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,underglow = &led_strip;
    };

    /* 逻辑 10x10 直接按 row-major 展开：keymap 第 n 项 = RC(n/10, n%10) */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <10>;
        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9)
        RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7) RC(5,8) RC(5,9)
        RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5) RC(6,6) RC(6,7) RC(6,8) RC(6,9)
        RC(7,0) RC(7,1) RC(7,2) RC(7,3) RC(7,4) RC(7,5) RC(7,6) RC(7,7) RC(7,8) RC(7,9)
        RC(8,0) RC(8,1) RC(8,2) RC(8,3) RC(8,4) RC(8,5) RC(8,6) RC(8,7) RC(8,8) RC(8,9)
        RC(9,0) RC(9,1) RC(9,2) RC(9,3) RC(9,4) RC(9,5) RC(9,6) RC(9,7) RC(9,8) RC(9,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        wakeup-source;

        /* 输出脚：只用 ACTIVE_HIGH */
        row-gpios
              = <&pro_micro 1 GPIO_ACTIVE_HIGH>        /* ROW0 = D1 */
              , <&pro_micro 0 GPIO_ACTIVE_HIGH>        /* ROW1 = D0 */
              , <&pro_micro 2 GPIO_ACTIVE_HIGH>        /* ROW2 = D2 */
              , <&pro_micro 3 GPIO_ACTIVE_HIGH>        /* ROW3 = D3 */
              , <&pro_micro 4 GPIO_ACTIVE_HIGH>        /* ROW4 = D4 */
              , <&pro_micro 5 GPIO_ACTIVE_HIGH>        /* ROW5 = D5 */
              , <&pro_micro 6 GPIO_ACTIVE_HIGH>        /* ROW6 = D6 */
              , <&pro_micro 7 GPIO_ACTIVE_HIGH>        /* ROW7 = D7 */
              , <&pro_micro 8 GPIO_ACTIVE_HIGH>        /* ROW8 = D8 */
              , <&pro_micro 9 GPIO_ACTIVE_HIGH>        /* ROW9 = D9 */
            ;

        /* 输入脚：必须带下拉，否则悬空会乱触发 */
        col-gpios
              = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* COL0 = D21 */
              , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* COL1 = D20 */
              , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* COL2 = D19 */
              , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* COL3 = D18 */
              , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* COL4 = D15 */
              , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* COL5 = D14 */
              , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* COL6 = D16 */
              , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* COL7 = D10 */
              , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>        /* COL8 = P1.01 */
              , <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>        /* COL9 = P1.02 */
            ;
    };
};

/* ============ RGB 灯链：SPI3 MOSI = P1.07，98 颗 SK6812 ============ */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 7)>;   /* P1.07 -> 电平转换 -> 灯链 DIN */
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 7)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>;                       /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;   /* 4MHz, WS2812/SK6812 标准 */

        /* WS2812 / SK6812: 98 颗 = 97 键下灯 + 1 状态灯 */
        chain-length = <98>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        /* SK6812/WS2812 数据顺序为 GRB -> GREEN RED BLUE */
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
