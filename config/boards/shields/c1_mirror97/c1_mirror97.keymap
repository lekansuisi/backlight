/*
 * C1 Mirror97 RGB · 97 键 keymap
 * 顺序 = 10x10 逻辑矩阵 row-major（与 overlay 的 default_transform 严格一致）
 * 3 个空位 (7,9)(8,9)(9,9) 与「预留」键位为 &none
 * 数字区在左且真镜像：Enter / + 竖装最左列，数字读序 3 2 1，NumLock 右上
 *
 * Fn 层新增 RGB 控制（&rgb_ug）：开关 / 亮度 / 色相 / 饱和度 / 效果
 *   放在原 Fn 层右侧空白区，不占用原有 BT/OUT/音量键位。
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
            &kp KP_MINUS        &kp KP_ASTERISK     &kp KP_DIVIDE       &kp KP_N9           &kp KP_N8           &kp KP_PLUS         &kp KP_N6           &kp KP_N3           &kp KP_ENTER        &kp KP_DOT   // R0: - * / 9 8 + 6 3 KP_Enter .
            &kp KP_NLCK         &kp KP_N7           &kp KP_N5           &kp KP_N4           &kp KP_N2           &kp KP_N1           &kp UP              &kp KP_N0           &kp LEFT            &kp DOWN   // R1: NumLock 7 5 4 2 1 Up 0 Left Down
            &kp ESC             &kp F1              &kp GRAVE           &kp N1              &kp TAB             &kp CAPS            &kp LSHIFT          &kp RIGHT           &kp LCTRL           &kp LGUI   // R2: Esc F1 ` 1 Tab Caps LShift Right LCtrl Win
            &kp F2              &kp F3              &kp N2              &kp N3              &kp Q               &kp W               &kp A               &kp S               &kp Z               &kp LALT   // R3: F2 F3 2 3 Q W A S Z LAlt
            &kp F4              &kp F5              &kp N4              &kp N5              &kp E               &kp R               &kp D               &kp F               &kp X               &kp C   // R4: F4 F5 4 5 E R D F X C
            &kp F6              &kp F7              &kp N6              &kp T               &kp Y               &kp G               &kp H               &kp V               &kp B               &kp SPACE   // R5: F6 F7 6 T Y G H V B Space
            &kp F8              &kp F9              &kp N7              &kp N8              &kp U               &kp I               &kp J               &kp K               &kp N               &kp M   // R6: F8 F9 7 8 U I J K N M
            &kp F10             &kp N9              &kp N0              &kp O               &kp P               &kp L               &kp COMMA           &kp DOT             &kp RALT            &none   // R7: F10 9 0 O P L , . RAlt —
            &kp F11             &kp F12             &kp MINUS           &kp EQUAL           &kp LBKT            &kp SEMI            &kp SQT             &kp SLASH           &mo 1               &none   // R8: F11 F12 - = [ ; ' / Fn —
            &none               &kp DEL             &kp BSPC            &kp RBKT            &kp BSLH            &kp RET             &kp RSHIFT          &kp K_APP           &kp RCTRL           &none   // R9: 预留 Del Backspace ] \ Enter RShift Menu RCtrl —
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
            &bt BT_CLR          &out OUT_TOG        &bt BT_SEL 0        &bt BT_SEL 1        &bt BT_SEL 2        &trans              &trans              &trans              &trans              &trans   // R0: BT_CLR / OUT_TOG / BT 0-2
            &bt BT_SEL 3        &bt BT_SEL 4        &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans   // R1: BT 3-4
            &trans              &kp C_VOL_DN        &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans   // R2: 音量减
            &kp C_VOL_UP        &kp C_MUTE          &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans   // R3: 音量加/静音
            &kp C_PLAY_PAUSE    &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans   // R4: 播放/暂停
            &rgb_ug RGB_TOG     &rgb_ug RGB_EFF     &rgb_ug RGB_EFR     &rgb_ug RGB_HUI     &rgb_ug RGB_HUD     &rgb_ug RGB_SAI     &rgb_ug RGB_SAD     &rgb_ug RGB_BRI     &rgb_ug RGB_BRD     &trans   // R5: RGB 开关/效果±/色相±/饱和±/亮度±
            &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans   // R6
            &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &none   // R7
            &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &none   // R8
            &none               &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &none   // R9
            >;
        };
    };
};
